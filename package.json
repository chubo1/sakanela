{
  "name": "sakanela",
  "private": true,
  "version": "0.1.0",
  "description": "Static multi-page site for Sakanela — Vite, SCSS (7-1), Vanilla JS.",
  "type": "module",
  "scripts": {
    "watch": "vite build --watch",
    "dev": "vite build --watch",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.js\" vite.config.js",
    "lint:fix": "eslint \"src/**/*.js\" vite.config.js --fix",
    "format": "prettier --write \"**/*.{js,scss,html,json,md,cjs}\"",
    "format:check": "prettier --check \"**/*.{js,scss,html,json,md,cjs}\""
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "swiper": "^14.2.0"
  }
}
